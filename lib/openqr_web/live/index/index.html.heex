<div
  id="qr-workspace"
  data-theme="light"
  class="grid min-h-0 grid-rows-[auto_minmax(0,1fr)] gap-4 px-6 pt-4"
>
  <div class="grid grid-cols-[minmax(0,2fr)_minmax(0,1fr)] gap-8">
    <header class="grid justify-items-center gap-4 py-2">
      <div class="grid text-brand-frame">
        <h1 id="qr-title" class="qr-title text-center">OpenQR</h1>
        <p class="qr-byline text-right">
          by
          <.link
            href="https://rispeng.com"
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-frame"
          >Ris Peng</.link>
        </p>
      </div>
      <nav
        aria-label="QR tools"
        class="grid w-full max-w-xl grid-cols-[1fr_1fr_1fr] gap-1.5 rounded-2xl bg-brand-frame p-1.5 text-content"
      >
        <.button
          :for={
            {tab, label, icon} <- [
              {"generate", "Generate", "hero-qr-code"},
              {"scan", "Scan", "hero-viewfinder-circle"},
              {"history", "History", "hero-clock"}
            ]
          }
          id={"qr-tab-#{tab}"}
          variant={if @active_tab == tab, do: :neutral, else: nil}
          type="button"
          phx-click="switch-tab"
          phx-value-tab={tab}
          aria-current={@active_tab == tab && "page"}
          aria-controls={"qr-#{tab}-panel"}
          class="min-w-0 grid-cols-[1rem_max-content] justify-center gap-2 aria-[current=page]:border-brand aria-[current=page]:font-semibold"
        ><.icon name={icon} class="size-4" />{label}</.button>
      </nav>
    </header>
  </div>
  <div
    id="qr-generate-panel"
    hidden={@active_tab != "generate"}
    class="grid min-h-0 grid-cols-[minmax(0,2fr)_minmax(0,1fr)] gap-8"
  >
    <section aria-label="QR editor" class="grid min-h-0 min-w-0">
      <div class="grid min-h-0 min-w-0 overflow-hidden rounded-3xl bg-primary text-content">
        <div id="qr-editor" class="qr-scroll min-h-0 min-w-0 overflow-y-auto p-6">
          <.form
            for={@form}
            id="qr-options"
            phx-hook="HaMRLink"
            phx-change="change"
            phx-submit="generate"
            class="grid min-w-0 gap-5"
          >
            <h2 class="text-lg font-semibold">Create your QR</h2>

            <p
              :if={@generation_error && !@selected_entry}
              id="generation-error"
              role="alert"
              class="rounded-xl inset-surface p-4 text-sm leading-6 text-content"
            >
              {@generation_error}
            </p>
            <div class="grid gap-2">
              <label for={@form[:payload].id} class="text-sm font-medium">Text or URL</label>
              <.input
                field={@form[:payload]}
                type="textarea"
                placeholder="https://example.com"
                rows="3"
                maxlength="10000"
                phx-debounce="400"
                clear_button={false}
                required
              />
            </div>
            <.input field={@form[:ha_mr_url]} type="hidden" />
            <div class="grid grid-cols-[1fr_1fr] items-start subgap-3">
              <div class="grid gap-2">
                <.input
                  field={@form[:vary_url]}
                  type="checkbox"
                  variant="alt"
                  label="Allow URL variants"
                />
                <p class="text-xs leading-5 text-subcontent">
                  Adds a random #fragment to website addresses without one. Fragments can affect client-side routing.
                </p>
              </div>
              <div class="grid gap-2">
                <.input field={@form[:ha_mr]} type="checkbox" variant="alt" label="ha.mr link" />
                <p class="text-xs leading-5 text-subcontent">
                  Compresses the URL into a ha.mr redirect link.
                </p>
                <div
                  id="ha-mr-output"
                  data-ha-mr-output
                  phx-update="ignore"
                  class="grid gap-1"
                  hidden
                >
                  <.link
                    data-ha-mr-result
                    href="#"
                    class="break-all text-sm underline underline-offset-2"
                  >{""}</.link>
                  <p data-ha-mr-status role="status" aria-live="polite" class="text-xs leading-5" />
                </div>
              </div>
            </div>

            <.collapse id="qr-artwork" open>
              <:summary>
                <span class="text-sm font-semibold">Images and background</span>
              </:summary>

              <div class="grid gap-4 pt-4">
                <div class="grid grid-cols-[minmax(0,1fr)_minmax(0,1fr)] items-start subgap-3">
                  <div class="grid gap-2">
                    <.input
                      field={@form[:auto_brand]}
                      type="checkbox"
                      variant="alt"
                      label="Use the website icon when no image is attached"
                    />
                    <p class="text-xs leading-5 text-subcontent">
                      Website icon lookup uses the internet. Uploaded images take priority.
                    </p>
                  </div>

                  <.input
                    field={@form[:background_transparent]}
                    type="checkbox"
                    variant="alt"
                    label="Transparent logo background"
                  />
                </div>

                <div
                  :for={
                    {name, label, filename, preview_ref, fit} <- [
                      {:reference, "Reference image", @reference_name, @reference_preview_ref,
                       "object-contain"},
                      {:background, "Background image", @background_name, @background_preview_ref,
                       "object-cover"}
                    ]
                  }
                  class={[
                    "grid items-center",
                    name == :background &&
                      "grid-cols-[repeat(auto-fit,minmax(min(100%,14rem),1fr))] gap-3"
                  ]}
                >
                  <div class="grid min-w-0 grid-cols-[min(5rem,25%)_minmax(0,20rem)] items-center gap-2">
                    <div
                      id={"qr-#{name}-square"}
                      class="relative grid aspect-square place-items-center overflow-hidden rounded-default border border-outline bg-primary"
                    >
                      <.file_preview
                        id={"qr-#{name}-pending"}
                        class="pointer-events-none absolute inset-0 z-10 size-full [&>[data-file-collection]]:pointer-events-auto"
                        data-file-retain-upload
                        data-file-accepted-ref={preview_ref}
                      />
                      <img
                        :if={preview_ref}
                        id={"qr-#{name}-accepted-#{preview_ref}"}
                        phx-update="ignore"
                        data-file-accepted-preview
                        alt={"#{label} preview: #{filename}"}
                        class={[
                          "absolute inset-0 z-[1] size-full bg-primary [&:not([src])]:hidden",
                          fit
                        ]}
                      />
                      <.icon name="hero-photo" class="size-6 text-subcontent" />
                    </div>

                    <div class="grid min-w-0 gap-2">
                      <.input
                        id={"qr-#{name}"}
                        upload={@uploads[name]}
                        label={label}
                        placeholder="Choose a file"
                        preview={true}
                        editor={
                          if(name == :background, do: %{ratio: 1}, else: %{presets: [{1, 1}]})
                        }
                        preview_id={"qr-#{name}-pending"}
                        thumbnail_class="size-full bg-primary"
                      >
                        <:pending_preview :let={entry}>
                          <.live_img_preview
                            entry={entry}
                            alt={"#{label} preview: #{entry.client_name}"}
                            class={["size-full rounded-default bg-primary", fit]}
                          />
                        </:pending_preview>
                      </.input>

                      <div
                        :if={filename}
                        class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-2 text-xs"
                      >
                        <span class="truncate" title={filename}>{filename}</span>
                        <button
                          type="button"
                          phx-click="remove-image"
                          phx-value-image={name}
                          aria-label={"Remove #{String.downcase(label)}"}
                          class="cursor-pointer underline"
                        >Remove</button>
                      </div>
                    </div>
                  </div>

                  <.input
                    :if={name == :background}
                    field={@form[:background_color]}
                    type="color"
                    label="Logo background color"
                    disabled={@settings.background_transparent}
                  />
                </div>

                <p class="text-xs leading-5 text-subcontent">
                  PNG, JPEG, WebP, or GIF. Up to 10 MB combined. The QR canvas and quiet border stay white. Animated reference images use Picture.
                </p>
              </div>
            </.collapse>

            <.input
              field={@form[:mode]}
              type="radio"
              variant="card"
              label="Rendering style"
              options={[
                {"Mosaic", "mosaic", description: "Image-shaped pattern"},
                {"Picture", "picture", description: "Image beneath the code"}
              ]}
              options_class="grid grid-cols-[1fr_1fr] gap-2"
              clear_button={false}
            />

            <.collapse id="qr-design" open>
              <:summary><span class="text-sm font-semibold">Mosaic design</span></:summary>
              <div
                id="qr-design-options"
                phx-hook="QRDesign"
                data-reliability={Jason.encode!(@reliability)}
                class="grid gap-5"
              >
                <p :if={!@designs_available?} class="text-xs leading-5 text-subcontent">
                  No reliable designs are available in the prepared catalog.
                </p>
                <.input
                  :for={
                    {field, title} <- [
                      body_shape: "Body shape",
                      eye_frame: "Eye frame",
                      eye_ball: "Eye ball"
                    ]
                  }
                  field={@form[field]}
                  type="radio"
                  variant="card"
                  label={title}
                  options={
                    Enum.map(@catalog[field], fn choice ->
                      {choice.label, choice.id, data: choice}
                    end)
                  }
                  options_class="grid grid-cols-[repeat(auto-fill,3.5rem)] gap-2"
                  option_class="qr-shape relative grid size-14 min-w-0 cursor-pointer place-items-center rounded-lg border border-outline bg-brand-frame p-2 has-[:checked]:border-brand has-[:checked]:outline-2 has-[:checked]:outline-brand has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-brand has-[:disabled]:cursor-not-allowed has-[:disabled]:opacity-50"
                  disabled={@showcase? || @settings.mode != "mosaic"}
                  clear_button={false}
                >
                  <:option :let={option}>
                    <img
                      :if={option.value != "follow-body"}
                      src={"data:image/svg+xml;base64,#{Base.encode64(option.data.preview)}"}
                      alt=""
                      width="36"
                      height="36"
                      class="size-9"
                    />
                    <span
                      :if={option.value == "follow-body"}
                      class="qr-follow-body-label text-center leading-3 text-content"
                    >Follow body</span>
                  </:option>
                </.input>
              </div>
            </.collapse>

            <.button
              variant={:primary}
              type="submit"
              id="generate-versions"
              disabled={@busy || (@settings.mode == "mosaic" && !@designs_available?)}
              class="justify-self-end"
            >
              Generate
            </.button>
          </.form>
        </div>
      </div>
    </section>
    <section
      id="qr-gallery"
      aria-labelledby="gallery-title"
      aria-busy={to_string(@busy)}
      class="qr-scroll min-h-0 overflow-y-auto pl-2 pr-1"
    >
      <header class="pb-4">
        <h2 id="gallery-title" class="text-base font-semibold text-brand-frame">
          {if @showcase?, do: "Design showcase", else: "Choose a version"}
        </h2>
        <p :if={@busy} role="status" class="mt-1 text-xs">Generating previews...</p>
      </header>
      <div
        id={if @showcase?, do: "qr-showcase", else: "qr-results"}
        phx-hook={@showcase? && "QRShowcase"}
        phx-update={if @showcase?, do: "ignore", else: "replace"}
        data-base-url={
          @showcase? && "/qr-defaults/#{Path.basename(OpenQR.DefaultQR.directory())}"
        }
        data-body={@showcase? && @gallery.settings.body_shape}
        data-frame={@showcase? && @gallery.settings.eye_frame}
        data-ball={@showcase? && @gallery.settings.eye_ball}
        data-selected-version={@selected_version}
      >
        <p
          :if={@showcase?}
          data-showcase-status
          role="status"
          aria-live="polite"
          class="mb-3 text-xs leading-5 text-brand-frame"
        >
          Loading all design previews...
        </p>
        <button
          :if={@showcase?}
          type="button"
          data-showcase-retry
          hidden
          class="mb-3 cursor-pointer text-xs font-semibold text-brand-frame underline"
        >Retry loading previews</button>
        <div class="grid grid-cols-[1fr_1fr_1fr_1fr] items-start gap-x-3 gap-y-5">
          <button
            :for={version <- 1..40}
            id={"qr-version-#{version}"}
            type="button"
            phx-click="select-version"
            phx-value-version={version}
            phx-value-body={@showcase? && @gallery.settings.body_shape}
            phx-value-frame={@showcase? && @gallery.settings.eye_frame}
            phx-value-ball={@showcase? && @gallery.settings.eye_ball}
            data-showcase-version={version}
            aria-label={"Inspect version #{version}"}
            aria-haspopup="dialog"
            aria-pressed={@selected_version == version}
            disabled={@showcase? || @busy || !Map.has_key?(@results, version)}
            title={@skipped[version]}
            class="qr-version grid min-w-0 cursor-pointer gap-2 text-center disabled:cursor-default focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-frame"
          >
            <span class="grid aspect-square place-items-center overflow-hidden rounded-xl bg-brand-frame p-1.5 outline-brand-frame aria-[current=true]:outline-2">
              <canvas
                :if={@showcase?}
                data-showcase-canvas
                hidden
                aria-label={"Version #{version} preview"}
                class="aspect-square w-full"
              />
              <img
                :if={
                  !@showcase? && @results[version] && Map.has_key?(@results[version], :preview)
                }
                src={
                  @results[version] &&
                    if(Map.has_key?(@results[version], :preview_url),
                      do: @results[version].preview_url,
                      else:
                        "data:image/#{@results[version].format};base64,#{Base.encode64(@results[version].preview)}"
                    )
                }
                alt={"Version #{version} preview"}
                width="180"
                height="180"
                class="aspect-square w-full"
                decoding="async"
              />
              <span
                :if={
                  @showcase? || !@results[version] || !Map.has_key?(@results[version], :preview)
                }
                data-showcase-unavailable
                hidden={
                  !@showcase? && !!@results[version] && Map.has_key?(@results[version], :preview)
                }
              >
                <.icon
                  name={if @busy, do: "hero-arrow-path", else: "hero-minus"}
                  class="size-5 text-subcontent"
                />
              </span>
            </span>
            <span class="qr-version-label text-brand-frame">v{version}</span>
          </button>
        </div>
        <details
          :if={@showcase? || map_size(@skipped) > 0}
          data-showcase-skipped
          hidden={map_size(@skipped) == 0}
          class="mt-6 rounded-xl bg-brand-frame p-4 text-xs text-content"
        >
          <summary data-showcase-skip-summary class="cursor-pointer font-semibold">
            {map_size(@skipped)} versions unavailable
          </summary>
          <ul data-showcase-skip-list class="mt-3 grid gap-2">
            <li :for={{version, reason} <- Enum.sort(@skipped)}>Version {version}: {reason}</li>
          </ul>
        </details>
      </div>
    </section>
  </div>

  <section
    :if={@active_tab == "scan"}
    id="qr-scan-panel"
    aria-labelledby="scanner-title"
    class="qr-scroll min-h-0 overflow-y-auto rounded-3xl bg-primary p-6 text-content"
  >
    <div
      id="qr-scanner"
      phx-hook="QRScanner"
      phx-update="ignore"
      data-worker-url={~p"/assets/qr-scanner-worker.js"}
      class="grid gap-5"
    >
      <header>
        <h2 id="scanner-title" class="text-lg font-semibold">Scan a QR code</h2>
        <p class="mt-1 text-sm leading-6 text-subcontent">
          Choose an image or start your camera. Successful scans save the image and decoded text in this browser.
        </p>
      </header>
      <div class="grid grid-cols-[1fr_1fr] gap-4">
        <div class="grid min-w-0 content-start gap-3 rounded-2xl inset-surface p-4">
          <label for="scan-file" class="text-sm font-medium">QR image</label>
          <div class="grid items-center gap-2 has-[canvas:not([hidden])]:grid-cols-[min(5rem,25%)_minmax(0,1fr)]">
            <canvas
              data-scan-preview
              hidden
              role="img"
              aria-label="Selected QR image preview"
              class="aspect-square w-full rounded-default border border-outline bg-primary object-contain"
            ></canvas>
            <.input
              id="scan-file"
              name="scan_file"
              data-scan-file
              type="file"
              accept="image/*"
              placeholder="Choose a QR image"
            />
          </div>
          <p class="text-xs leading-5 text-subcontent">
            Up to 25 MB. PNG, JPEG, WebP, GIF, or SVG. Animated images are scanned as a still image.
          </p>
        </div>
        <div class="grid content-start gap-3 rounded-2xl inset-surface p-4">
          <p class="text-sm font-medium">Camera</p>
          <p class="text-xs leading-5 text-subcontent">Uses the rear camera when available.</p>
          <div class="grid grid-cols-[1fr_1fr] gap-2">
            <.button data-scan-start variant={:primary} type="button">Start camera</.button>
            <.button data-scan-stop variant={:neutral} type="button" hidden>Stop camera</.button>
          </div>
        </div>
      </div>
      <video
        data-scan-video
        muted
        playsinline
        hidden
        class="mx-auto max-h-[45svh] w-full rounded-2xl bg-brand-ink object-contain"
      ></video>
      <p
        data-scan-status
        role="status"
        aria-live="polite"
        class="text-sm leading-6 text-subcontent empty:sr-only"
      >
        Ready to scan.
      </p>
      <p data-scan-announcement role="status" class="sr-only"></p>
      <p
        data-scan-history-warning
        role="status"
        class="text-sm leading-6 text-error empty:sr-only"
      >
      </p>
      <div data-scan-results class="grid gap-3"></div>
    </div>
  </section>

  <section
    id="qr-history-panel"
    hidden={@active_tab != "history"}
    aria-labelledby="history-title"
    class="qr-scroll min-h-0 overflow-y-auto rounded-3xl bg-primary p-6 text-content"
  >
    <div id="qr-history" phx-hook="QRHistory" phx-update="ignore" class="grid gap-5">
      <header class="grid grid-cols-[1fr_max-content] items-start gap-4">
        <div>
          <h2 id="history-title" class="text-lg font-semibold">History</h2>
          <p class="mt-1 text-sm leading-6 text-subcontent">
            Scanned text, scan images, and downloaded QR codes are saved in this browser. Clearing browser data removes them.
          </p>
        </div>
        <.button data-history-clear variant={:neutral} type="button" disabled>Clear history</.button>
      </header>
      <p
        data-history-status
        tabindex="-1"
        role="status"
        aria-live="polite"
        class="text-sm leading-6 text-subcontent empty:sr-only"
      >
        No history yet.
      </p>
      <div
        data-history-list
        class="grid grid-cols-[repeat(auto-fill,minmax(13rem,1fr))] items-start gap-4"
      >
      </div>
      <template data-history-entry>
        <article
          data-history-card
          class="grid min-w-0 gap-3 rounded-2xl border border-outline p-4"
        >
          <div class="relative aspect-square">
            <img
              data-history-image
              width="180"
              height="180"
              loading="lazy"
              class="aspect-square w-full object-contain [&:not([src])]:invisible"
            />
            <p
              data-history-preview-error
              hidden
              class="absolute inset-0 grid place-items-center text-center text-xs text-subcontent"
            >
              Original image unavailable.
            </p>
          </div>
          <div class="grid gap-1">
            <h3 data-history-title class="text-sm font-semibold"></h3>
            <p
              data-history-payload
              class="whitespace-pre-wrap break-all text-xs leading-5 text-subcontent"
            >
            </p>
            <time data-history-date class="text-xs text-subcontent"></time>
          </div>
          <div class="grid grid-cols-[minmax(0,1fr)_2.75rem] gap-2 has-[[data-history-open]]:grid-cols-[minmax(0,1fr)_2rem_2.75rem]">
            <.button data-history-download href="#" variant={:primary}>Download</.button>
            <.button data-history-copy variant={:primary} type="button">Copy</.button>
            <a
              data-history-open
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Open link in a new tab"
              title="Open link in a new tab"
              class="grid min-h-11 place-items-center rounded-default text-brand hover:text-content focus-visible:outline-2 focus-visible:outline-brand"
            ><.icon name="tabler-external-link" class="size-5" /></a>
            <.action_button action={:delete} data-history-remove tooltip="Remove from history" />
          </div>
        </article>
      </template>
    </div>
  </section>

  <.modal
    :if={@selected_entry}
    id="version-modal"
    label={"Version #{@selected_version}"}
    return_focus={"#qr-version-#{@selected_version}"}
    on_cancel={JS.push("close-version")}
  >
    <article
      id="version-card"
      phx-hook="QRDownloads"
      data-payload={@selected_entry.payload}
      data-version={@selected_version}
      class="qr-scroll max-h-[calc(100svh-5rem)] overflow-y-auto bg-primary p-1 text-content"
      aria-labelledby="selected-title"
    >
      <header class="grid grid-cols-[1fr_2rem] items-center gap-3">
        <div>
          <h2 id="selected-title" class="text-lg font-semibold">Version {@selected_version}</h2>
          <p :if={@selected_busy || @busy} role="status" class="mt-1 text-xs text-subcontent">
            Preparing verified export...
          </p>
        </div>
        <button
          type="button"
          phx-click="close-version"
          aria-label="Close version"
          class="grid size-8 cursor-pointer place-items-center rounded-full focus-visible:outline-2 focus-visible:outline-content"
        ><.icon name="hero-x-mark" class="size-4" /></button>
      </header>
      <% {previous, next} = neighboring_versions(@results, @selected_version) %>
      <div
        class="grid grid-cols-[2.75rem_minmax(0,1fr)_2.75rem] items-center gap-2 py-4"
        aria-busy={to_string(@selected_busy)}
      >
        <.button
          id="previous-version"
          variant={:text}
          type="button"
          phx-click={JS.push("browse-version", loading: "#version-card")}
          phx-value-direction="previous"
          aria-label="Previous version"
          disabled={is_nil(previous)}
          class="size-11 hover:bg-control"
        ><.icon name="hero-chevron-left" class="size-6" /></.button>
        <div class="grid min-h-44 min-w-0 place-items-center">
          <img
            :if={image = Map.get(@selected_entry, :image) || Map.get(@selected_entry, :preview)}
            id="selected-qr"
            src={"data:image/#{@selected_entry.format};base64,#{Base.encode64(image)}"}
            alt={"QR code version #{@selected_version}"}
            class="aspect-square max-h-[42svh] max-w-full rounded-xl object-contain"
          />
        </div>
        <.button
          id="next-version"
          variant={:text}
          type="button"
          phx-click={JS.push("browse-version", loading: "#version-card")}
          phx-value-direction="next"
          aria-label="Next version"
          disabled={is_nil(next)}
          class="size-11 hover:bg-control"
        ><.icon name="hero-chevron-right" class="size-6" /></.button>
      </div>
      <div class="grid gap-3">
        <p
          :if={@generation_error}
          id="generation-error"
          role="alert"
          class="rounded-xl inset-surface p-3 text-sm leading-6 text-content"
        >
          {@generation_error}
        </p>
        <div
          :if={!@selected_busy && Map.has_key?(@selected_entry, :image)}
          class="grid grid-cols-[1fr_1fr] gap-2 phx-click-loading:invisible"
        >
          <.button
            variant={:primary}
            href="#"
            data-download-type={"image/#{@selected_entry.format}"}
            data-download-content={Base.encode64(@selected_entry.image)}
            download={"openqr-v#{@selected_version}.#{@selected_entry.format}"}
          >Download {String.upcase(to_string(@selected_entry.format))}</.button>
          <.button
            :if={@selected_entry.svg != ""}
            variant={:neutral}
            href="#"
            data-download-type="image/svg+xml"
            data-download-content={Base.encode64(@selected_entry.svg)}
            download={"openqr-v#{@selected_version}.svg"}
          >Download SVG</.button>
        </div>
        <.form
          for={@regeneration_form}
          id="qr-regeneration"
          phx-change="change-regeneration"
          phx-submit="regenerate"
          class="grid gap-3 border-t border-outline pt-4"
        >
          <div class="grid grid-cols-[1fr_1fr] items-end gap-2">
            <div class="grid content-start gap-1">
              <label for={@regeneration_form[:seed].id} class="text-xs font-medium">Seed</label>
              <.input
                field={@regeneration_form[:seed]}
                type="number"
                placeholder={to_string(@selected_entry.seed)}
                min="0"
                max="4294967295"
                step="1"
                clear_button={false}
              />
            </div>
            <.button
              id="regenerate-version"
              variant={:primary}
              type="submit"
              disabled={@selected_busy || @busy}
              class="grid-cols-[1rem_max-content] justify-center gap-2"
            >
              <.icon name="hero-arrow-path" class="size-4" /> Regenerate version
            </.button>
          </div>
          <p class="text-xs leading-5 text-subcontent">
            Leave the seed empty to choose a new one each time.
          </p>
        </.form>
        <p class="break-all text-xs leading-5 text-subcontent">{@selected_entry.payload}</p>
        <p
          data-download-status
          role="status"
          aria-live="polite"
          class="text-xs leading-5 text-error"
        >
        </p>
      </div>
    </article>
  </.modal>
</div>
